# Copy to .env in the directory from which you launch Shunt.
# Process environment overrides .env; explicit server --host/--port override both.
SHUNT_HOST=127.0.0.1
SHUNT_PORT=18765

# Shared OpenAI-compatible target endpoint. Set the target port inside the URL.
# Assume all three models are served by Ollama; no authentication by default.
SHUNT_TARGET_BASE_URL=http://127.0.0.1:11434/v1
SHUNT_TARGET_API_KEY=
SHUNT_TARGET_TIMEOUT_SECONDS=120

# Default recommendations. These are assumed local Ollama aliases, not verified
# registry tags. Import/create the weights under these names, or change them.
SHUNT_T1_MODEL=mimo-v2.6-distill-qwen-9b
SHUNT_T2_MODEL=qwen3.8:27b
SHUNT_T3_MODEL=deepseek-v4.1-flash:1017

# Optional per-tier overrides. Omit to inherit the shared settings.
# SHUNT_T1_BASE_URL=http://127.0.0.1:11435/v1
# SHUNT_T2_BASE_URL=http://192.168.1.20:11434/v1
# SHUNT_T3_BASE_URL=https://inference.example.com/v1
# SHUNT_T3_API_KEY="replace-with-your-key"
# SHUNT_T3_TIMEOUT_SECONDS=300
